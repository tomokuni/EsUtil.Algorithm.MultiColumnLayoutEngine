<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- ライブラリと同じ .NET 10 / C# 14 を対象とする -->
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StartupObject>EsUtil.Algorithm.MultiColumnLayoutEngineTest.Benchmark</StartupObject>
  </PropertyGroup>

  <!-- プロダクト情報 -->
  <PropertyGroup>
    <AssemblyName>EsUtil.Algorithm.MultiColumnLayoutEngine.Test</AssemblyName>
    <RootNamespace>EsUtil.Algorithm.MultiColumnLayoutEngine.Test</RootNamespace>
  </PropertyGroup>

  <!-- パッケージ情報 -->
  <PropertyGroup>
    <PackageId>$(AssemblyName)</PackageId>
    <PackageProjectUrl>https://github.com/tomokuni/EsUtil.Algorithm.MultiColumnLayoutEngine</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tomokuni/EsUtil.Algorithm.MultiColumnLayoutEngine</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>SEKIYA.Tomokuni</Authors>
    <Company>Estable</Company>
    <Copyright>SEKIYA.Tomokuni</Copyright>
    <PublishTrimmed>False</PublishTrimmed>
    <PublishAot>False</PublishAot>
    <GenerateDocumentationFile>False</GenerateDocumentationFile>
    <IsPublishable>False</IsPublishable>
    <!-- テストプロジェクトは配布しない（ソリューション単位の dotnet pack でも nupkg を作らない） -->
    <IsPackable>False</IsPackable>
  </PropertyGroup>

  <!-- テスト対象プロジェクトに依存 -->
  <ItemGroup>
    <ProjectReference Include="../src/MultiColumnLayoutEngine.csproj" />
  </ItemGroup>

  <!-- テストライブラリ -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="Microsoft.VisualStudio.DiagnosticsHub.BenchmarkDotNetDiagnosers" Version="18.7.37220.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
