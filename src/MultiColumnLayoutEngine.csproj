<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- .NET 10 / C# 14 を対象とする -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
    <PackageTags>Vertical;multi;column;layout;</PackageTags>
    <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- プロダクト情報 -->
  <!-- バージョンはリポジトリルートの Directory.Build.props が単一所有する（ここでは指定しない） -->
  <PropertyGroup>
    <Product>MultiColumnLayoutEngine</Product>
    <Description>Vertical multi-column layout algorithm engine with support for multiple optimization strategies</Description>
    <RootNamespace>EsUtil.Algorithm</RootNamespace>
    <AssemblyName>EsUtil.Algorithm.MultiColumnLayoutEngine</AssemblyName>
  </PropertyGroup>

  <!-- パッケージ情報 -->
  <PropertyGroup>
    <PackageId>$(AssemblyName)</PackageId>
    <PackageProjectUrl>https://github.com/tomokuni/EsUtil.Algorithm.MultiColumnLayoutEngine</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tomokuni/EsUtil.Algorithm.MultiColumnLayoutEngine</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>SEKIYA.Tomokuni</Authors>
    <Company>Estable</Company>
    <Copyright>SEKIYA.Tomokuni</Copyright>
    <!-- GeneratePackageOnBuild は使用しない（クリーンな状態の dotnet pack が NU5026 で失敗するため） -->
    <!-- パッケージ化は build の後に pack を no-build で実行する（.github/workflows の build.yml / publish.yml を参照） -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- 追加アイテム -->
  <ItemGroup>
    <!-- README は NuGet パッケージに同梱する -->
    <Content Include="..\README.md" Pack="true" PackagePath="" />
    <!-- Copilot 指示書はソリューション エクスプローラーで参照するのみ（パッケージには含めない） -->
    <Content Include="..\.github\copilot-instructions.md" Pack="false" />
  </ItemGroup>

  <!-- パッケージ -->

</Project>
